cc_library_shared {
    name: "libarbitrarybytes",
    vendor: true,

    srcs: [
        "src/frameparser.cpp",
        "src/h264_utils.cpp",
        "src/hevc_utils.cpp",
    ],

    cflags: [
        "-Werror",
        "-D_ANDROID_",
    ],

    // media/msm_media_info.h + msm_vidc_utils.h - kernel source UAPI.
    // Same rationale as libc2dcolorconvert/Android.bp.
    include_dirs: [
        "kernel/xiaomi/sm8150/techpack/video/include/uapi/vidc",
    ],

    header_libs: [
        "libarbitrarybytes_headers",
        "libomxcommon_headers",
        "libomxcore_headers",
        "libutils_headers",
        "qti_kernel_headers",
    ],

    shared_libs: [
        "libcutils",
        "liblog",
    ],
}

cc_library_headers {
    name: "libarbitrarybytes_headers",
    export_include_dirs: ["inc"],
    vendor: true,
}
