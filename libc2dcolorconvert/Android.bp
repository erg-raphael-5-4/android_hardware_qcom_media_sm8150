cc_library_shared {
    name: "libc2dcolorconvert",
    vendor: true,

    srcs: [
        "C2DColorConverter.cpp",
    ],

    cflags: [
        "-Werror",
    ],

    // c2d2.h ships in hardware/qcom-caf/sm8150/display/libcopybit but the
    // sm8150 display modules are disabled in this build (sm8350 provides
    // the active display HAL, and sm8350 dropped libcopybit). The headers
    // remain on disk so we point at them directly.
    include_dirs: [
        "hardware/qcom-caf/sm8150/display/libcopybit",
    ],

    header_libs: [
        "display_headers",
        "qti_kernel_headers",
    ],

    shared_libs: [
        "libdl",
        "liblog",
    ],
}

cc_library_headers {
    name: "libc2dcolorconvert_headers",
    // c2d2.h is included by C2DColorConverter.h, so any consumer of this
    // header lib (libOmxVenc, libOmxVdec, ...) needs the libcopybit path
    // too. Export it here so we don't have to repeat in every consumer.
    export_include_dirs: [
        ".",
        "../../display/libcopybit",
    ],
    vendor: true,
}
