cc_library_shared {
    name: "libc2dcolorconvert",
    vendor: true,

    srcs: [
        "C2DColorConverter.cpp",
    ],

    cflags: [
        "-Werror",
    ],

    // c2d2.h ships in hardware/qcom-caf/sm8150/display/libcopybit but the
    // sm8150 display modules are disabled in this build (sm8350 provides
    // the active display HAL, and sm8350 dropped libcopybit). The headers
    // remain on disk so we point at them directly.
    include_dirs: [
        "hardware/qcom-caf/sm8150/display/libcopybit",
    ],

    header_libs: [
        "display_headers",
        "qti_kernel_headers",
    ],

    shared_libs: [
        "libdl",
        "liblog",
    ],
}

cc_library_headers {
    name: "libc2dcolorconvert_headers",
    // C2DColorConverter.h pulls in c2d2.h, which lives in the disabled
    // sm8150 display/libcopybit tree. We symlink c2d2.h into this dir so
    // a plain `.` export covers it for all consumers. Soong forbids ../
    // paths in export_include_dirs; the symlink is the easy way around.
    export_include_dirs: ["."],
    vendor: true,
}
