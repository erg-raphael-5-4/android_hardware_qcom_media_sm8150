# Extra syscalls on top of android.hardware.media.c2-default-seccomp_policy,
# which is written for the AOSP *software* codecs and kills this service with
# SIGSYS as soon as the V4L2 engine runs.
#
# Built as a superset of the two QTI Codec2 policies already on this device --
# codec2.vendor.base-arm.policy and codec2.vendor.ext-arm.policy -- because the
# QTI Codec2 service drives the same msm_vidc engine and its policy is proven
# sufficient in practice. Entries already in the default policy are omitted.
# Added on top: the calls the engine's async V4L2 poll thread makes (eventfd2
# for m_poll_efd being the one that killed us first), plus thread-priority and
# socket calls pulled in with it.
#
# 32-bit-only aliases from the QTI policies (mmap2, fstat64, _llseek, *32) are
# left in deliberately: minijail warns "nonexistent syscall" on arm64 and
# carries on, which is cheaper than maintaining two lists.

_llseek: 1
bind: 1
clock_nanosleep: 1
close_range: 1
connect: 1
dup3: 1
epoll_create1: 1
epoll_ctl: 1
epoll_pwait: 1
eventfd2: 1
fcntl: 1
fstat64: 1
fstatat64: 1
fstatfs64: 1
ftruncate64: 1
getcwd: 1
getegid32: 1
geteuid32: 1
getgid32: 1
getgroups32: 1
getpriority: 1
getsockopt: 1
getuid32: 1
membarrier: 1
mkdirat: 1
mmap2: 1
open: 1
poll: 1
pselect6: 1
readlink: 1
recvfrom: 1
rseq: 1
rt_sigtimedwait: 1
sched_getaffinity: 1
sched_getparam: 1
sched_getscheduler: 1
sched_setaffinity: 1
sched_setparam: 1
sched_setscheduler: 1
sendmsg: 1
sendto: 1
setsockopt: 1
sigreturn: 1
socket: 1
statfs: 1
sysinfo: 1
ugetrlimit: 1
unlinkat: 1

# Also present in the platform's own /system/etc/seccomp_policy/mediacodec.policy
# -- the policy for the domain this service actually runs in. The AOSP
# *software*-codec policy this extends is deliberately tighter than a hardware
# codec needs, which is the wrong baseline for a V4L2 encoder.
fsetxattr: 1
inotify_add_watch: 1
inotify_init1: 1
inotify_rm_watch: 1
sched_get_priority_max: 1
sched_get_priority_min: 1
statfs64: 1
timer_create: 1
timer_settime: 1
timer_delete: 1
uname: 1
faccessat2: 1
readlinkat: 1
getdents64: 1
pipe2: 1
tee: 1
splice: 1
